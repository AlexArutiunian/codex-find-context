# Обычно ничего менять не нужно.
CODEX_HOME=~/.codex
CODEX_CONTEXT_DATA_DIR=~/.local/share/codex-find-context
CODEX_CONTEXT_HOST=127.0.0.1
CODEX_CONTEXT_PORT=7860
CODEX_CONTEXT_AUTO_INDEX=1
CODEX_CONTEXT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Спокойные desktop defaults для фоновой индексации.
CODEX_CONTEXT_EMBED_THREADS=2
CODEX_CONTEXT_INDEX_BATCH=32
CODEX_CONTEXT_INDEX_PAUSE=0.08
CODEX_CONTEXT_STATUS_REFRESH=5
